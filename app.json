{
  "expo": {
    "name": "DigiSol PayTrack",
    "slug": "digisol-paytrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digisol.paytrack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "com.digisol.paytrack"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
